generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  leads Lead[]
  tasks Task[]
}

model Lead {
  id      String @id @default(cuid())
  name    String
  company String?
  email   String?
  phone   String?

  /// Slug do estágio definido em src/lib/pipeline.ts.
  /// Guardado como texto para trocar o funil sem migration.
  stage String @default("novo")

  /// Decimal, nunca Float: valor monetário não aceita erro de arredondamento.
  value Decimal @db.Decimal(12, 2) @default(0)

  score          Int       @default(0)
  source         String?
  lostReason     String?
  nextFollowUpAt DateTime?
  closedAt       DateTime?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  tasks Task[]
  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUpAt])
}

model Task {
  id      String    @id @default(cuid())
  title   String
  dueAt   DateTime?
  doneAt  DateTime?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([dueAt])
}

model Note {
  id      String @id @default(cuid())
  body    String
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([leadId])
}
